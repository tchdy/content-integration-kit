<?xml version="1.0" encoding="UTF-8"?>
<!--
  Target content model for an article. Every article stored by the kit
  (whether received by webhook or migrated from the legacy system) must
  validate against this schema first.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <xs:simpleType name="Status">
    <xs:restriction base="xs:string">
      <xs:enumeration value="draft"/>
      <xs:enumeration value="review"/>
      <xs:enumeration value="published"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ArticleId">
    <xs:restriction base="xs:string">
      <xs:pattern value="[a-z0-9][a-z0-9\-]{2,63}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="article">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="title" type="xs:string"/>
        <xs:element name="byline">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="author" type="xs:string" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="published" type="xs:date" minOccurs="0"/>
        <xs:element name="section" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="heading" type="xs:string" minOccurs="0"/>
              <xs:element name="para" type="xs:string" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="tags" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="tag" type="xs:string" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="id" type="ArticleId" use="required"/>
      <xs:attribute name="status" type="Status" use="required"/>
      <xs:attribute name="legacy-id" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
